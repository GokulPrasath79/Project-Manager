# PostgreSQL connection string (Neon, Render, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_manager?schema=public"
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=4000
# Comma-separated list of allowed web origins
CORS_ORIGINS="http://localhost:5173"
NODE_ENV=development
